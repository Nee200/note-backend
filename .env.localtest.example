NODE_ENV=development
PORT=4242
LOCAL_DEV_SAFE_MODE=true

# Nur lokale MongoDB fuer sicheren Testmodus verwenden.
MONGO_URI=mongodb://127.0.0.1:27017/note-localtest

# Fuer lokalen Safe-Mode reicht ein eigener Test-Secret.
JWT_SECRET=local-test-secret-change-me
ADMIN_PASSWORD=change-me

# Im Safe-Mode werden keine echten Stripe-/Mail-Aktionen ausgefuehrt.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RESEND_API_KEY=re_placeholder
