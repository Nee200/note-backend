NODE_ENV=production
NODE_VERSION=24.20.0
PORT=4242

# Public URLs (no trailing slash)
FRONTEND_PUBLIC_URL=https://note-fragrances.de
BACKEND_PUBLIC_URL=https://note-backend-5gy0.onrender.com

# Optional extra CORS origins (comma-separated)
TRUSTED_BROWSER_ORIGINS=https://www.note-fragrances.de

# Required secrets (set real values in hosting, never commit secrets)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=<long-random-secret>
# Two separate accounts with full admin access; each person enrolls their own MFA.
# Store only bcrypt password hashes (cost 12 recommended), and distinct Base32 secrets.
ADMIN_ACCOUNTS_JSON=[{"username":"betreiber","passwordHash":"<bcrypt-operator>","totpSecret":"<base32-operator>"},{"username":"admin","passwordHash":"<bcrypt-administrator>","totpSecret":"<base32-administrator>"}]
PROXY_SHARED_SECRET=<random-secret-at-least-32-bytes-same-in-worker-and-render>
NEWSLETTER_UNSUBSCRIBE_SECRET=<separate-long-lived-random-secret-at-least-32-bytes>
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
RESEND_API_KEY=<re_...>

# Rechnungen (Defaults entsprechen den derzeitigen Angaben im Impressum)
# Rechnungsbereich und automatische Erzeugung aktiv. Deaktivieren mit: INVOICES_ENABLED=false
INVOICES_ENABLED=true
# Öffentliche Bestellnummern (#1, #2, #3 ...)
ORDER_SEQUENCE_START=1
INVOICE_NUMBER_PREFIX=RE
# Falls bereits Rechnungen in derselben Nummernserie existieren: auf die nächste freie Nummer setzen.
INVOICE_SEQUENCE_START=1
INVOICE_VAT_RATE=19
INVOICE_AUTOMATIC_COUNTRIES=DE
INVOICE_SELLER_NAME=Note Fragrances
INVOICE_SELLER_OWNER=Deniz Löbel
INVOICE_SELLER_STREET=Warnitzer Str. 20
INVOICE_SELLER_POSTAL_CODE=13057
INVOICE_SELLER_CITY=Berlin
INVOICE_SELLER_COUNTRY=DE
INVOICE_SELLER_EMAIL=info@note-fragrances.de
INVOICE_SELLER_VAT_ID=DE315774154

# Use Node.js 24.20.0 or a newer patched 24.x release.
# Background jobs are durable; no dependency scans run in the web process.
